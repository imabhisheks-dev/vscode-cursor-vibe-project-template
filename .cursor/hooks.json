{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block-dangerous.sh",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/log-tool-use.sh"
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/format-changed-files.sh"
      }
    ]
  }
}
